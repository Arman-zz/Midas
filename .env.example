# Optional preferred provider. Without this key, the chart automatically uses
# CoinGecko's PAX Gold BDT market series.
VITE_METALPRICE_API_KEY=your_api_key_here

# Optional secure chatbot endpoint. It must accept POST JSON and return { "reply": "..." }.
# Keep AI provider keys on that server—never expose them through a VITE_ variable.
VITE_MIDAS_CHAT_API_URL=https://your-backend.example.com/api/chat
